# ==============================================================================
# YouTube Automation Platform - Environment Configuration Example
#
# INSTRUCTIONS:
# Copy this file to '.env' (which is ignored by Git) and update the values.
# DO NOT commit real secrets, API keys, or passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# The environment the application is running in (development, testing, staging, production)
NODE_ENV=development
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. BACKEND / FASTAPI CONFIGURATION
# ------------------------------------------------------------------------------
# Use a strong randomly generated string in production
SECRET_KEY=change-me-in-production
# Space-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000 http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Expected format: postgresql://[user]:[password]@[host]:[port]/[database]
# The values below match the default docker-compose.yml setup
DATABASE_URL=postgresql://user:password@postgres:5432/youtube_db

# ------------------------------------------------------------------------------
# 4. REDIS & CELERY CONFIGURATION
# ------------------------------------------------------------------------------
# The values below match the default docker-compose.yml setup
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 5. PROVIDER ABSTRACTIONS (PLACEHOLDERS FOR FUTURE PHASES)
# ------------------------------------------------------------------------------
# AI Text Generation
# OPENAI_API_KEY=sk-placeholder
# ANTHROPIC_API_KEY=sk-placeholder

# Text-To-Speech (TTS)
# ELEVENLABS_API_KEY=placeholder

# Image / Video Generation
# HIGGSFIELD_API_KEY=placeholder

# ------------------------------------------------------------------------------
# 6. YOUTUBE / GOOGLE OAUTH CONFIGURATION (FUTURE PHASE)
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=placeholder-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/callback
